<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/gen_widget_res.py -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/wbg_dracula">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:background="@drawable/wdeco_dracula"
                android:importantForAccessibility="no" />

            <!-- Normal mode: quote auto-fitted, author underneath -->
            <LinearLayout
                android:id="@+id/widget_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="0dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.12"
                    android:textColor="#F8F8F2"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/widget_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FF79C6"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Long-quote mode: scrolls, used when the quote won't fit at a readable size -->
            <ListView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="0dp"
                android:divider="@null"
                android:fadeScrollbars="false"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="4dp"
        android:alpha="0.65"
        android:fontFamily="sans-serif-medium"
        android:textColor="#F8F8F2"
        android:textSize="11sp" />
</LinearLayout>
